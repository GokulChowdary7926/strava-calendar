# Copy this file to .env and fill in your own values.
# Set DEMO_MODE=true to test the full UI without needing Strava credentials.
DEMO_MODE=true

# Get CLIENT_ID and CLIENT_SECRET from https://www.strava.com/settings/api
# (create a "My API Application" — see README Step 1)

STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here

# Must exactly match the "Authorization Callback Domain" you set in Strava's API settings.
# For local dev, set the Strava "Authorization Callback Domain" to: localhost
STRAVA_REDIRECT_URI=http://localhost:3000/auth/strava/callback

# Any long random string — used to sign the session cookie
SESSION_SECRET=change_this_to_a_random_string

PORT=3000
